{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "lib",
    "rootDir": ".",
    "declaration": true,
    "sourceMap": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "rewriteRelativeImportExtensions": true
  },
  "include": ["schema.ts", "src/**/*.ts"],
  "exclude": ["tests"]
}
